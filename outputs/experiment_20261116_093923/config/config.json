  "wosg": {
    "wavelet": "db4",
    "level": 7,
    "mode": "symmetric",
    "optimize": true,
    "window_candidates": [
      9,
      21
    ],
    "polyorder_candidates": [
      2
    ],
    "fixed_window": 21,
    "fixed_polyorder": 2,
    "objective": "lowfreq_residual_plus_inband_decorrelation",
    "lambda_inband": 1.0,
    "lowfreq_cut_hz": 0.5,
